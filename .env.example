# 이 파일을 복사해서 .env 를 만들고 TiDB Cloud 콘솔의 Connect 화면 값으로 채우세요.
#   cp .env.example .env
# (.env 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않습니다)

DB_URL=jdbc:mysql://<HOST>:4000/first_project?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=<USERNAME>
DB_PASSWORD=<PASSWORD>

# ---------- 시세 API 키 (비워두면 해당 기능만 "키 없음" 안내가 뜹니다) ----------

# 공공데이터포털 일반 인증키 (금 시세 + 부동산 실거래가 공용, Decoding 키 권장)
#  - 금융위원회_일반상품시세정보, 국토교통부_아파트 매매 실거래가 자료 둘 다 "활용신청" 해야 합니다
DATA_GO_KR_SERVICE_KEY=

# 한국수출입은행 환율 API 인증키 (https://www.koreaexim.go.kr 에서 별도 발급)
KOREAEXIM_AUTH_KEY=

# 한국투자증권 KIS Developers (모의투자 앱키) — 절대 Git/프론트엔드에 넣지 마세요
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자 계좌번호 10자리 (예: 50012345-01)
KIS_ACCOUNT_NO=
KIS_MOCK=true
